<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8B0000">

    <!-- Mapa de fondo -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:layout_marginBottom="180dp"
        android:alpha="0.4" />

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header con SIMULACRO y título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="40dp"
            android:paddingBottom="16dp"
            android:background="#CC8B0000">

            <TextView
                android:id="@+id/tvSimulacro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ SIMULACRO ⚠"
                android:textColor="#FFD700"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALERTA SÍSMICA"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <!-- Magnitud y profundidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:background="#998B0000">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="32dp">

                <TextView
                    android:id="@+id/tvMagnitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M 5.0"
                    android:textColor="#FF6600"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAGNITUD"
                    android:textColor="#FF9999"
                    android:textSize="10sp"
                    android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10.0 km"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFUNDIDAD"
                    android:textColor="#FF9999"
                    android:textSize="10sp"
                    android:letterSpacing="0.2" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contador regresivo GRANDE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:background="#BB000000">

            <TextView
                android:id="@+id/tvSecondsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEGUNDOS PARA EL SISMO"
                android:textColor="#FF9999"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textColor="#FFFFFF"
                android:textSize="96sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-thin" />
        </LinearLayout>

        <!-- Espacio para el mapa -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Instrucciones de seguridad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#CC000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTRUCCIONES DE SEGURIDAD"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="12dp"
                android:layout_gravity="center_horizontal" />

            <!-- Instrucción 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/circle_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ASEGÚRESE de tener una ruta de evacuación clara"
                    android:textColor="#FFCCCC"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Instrucción 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/circle_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  CUÍDESE y mantenga la calma"
                    android:textColor="#FFCCCC"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Instrucción 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/circle_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  PÓNGASE en un lugar resistente (mesa, marco de puerta)"
                    android:textColor="#FFCCCC"
                    android:textSize="13sp"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón "Estoy a salvo" -->
        <Button
            android:id="@+id/btnSafe"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:text="ESTOY A SALVO"
            android:textColor="#8B0000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</FrameLayout>
